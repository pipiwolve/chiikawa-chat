<view class="chat-container"><view class="chat-right"><view class="chat-header">{{a}}</view><scroll-view scroll-y class="msg-list" scroll-top="{{d}}" bindscrolltoupper="{{e}}" scroll-with-animation><view wx:for="{{b}}" wx:for-item="item" wx:key="j" class="{{['msg-item', item.k, item.l, item.m, item.n, item.o]}}"><view class="msg-nickname">{{item.a}}</view><view class="msg-content">{{item.b}}</view><view class="msg-timestamp">{{item.c}}</view><view wx:if="{{item.d}}" class="msg-status"><text wx:if="{{item.e}}">发送中...</text><text wx:elif="{{item.f}}"><button bindtap="{{item.g}}">重试</button></text><text wx:elif="{{item.h}}">未读</text><text wx:elif="{{item.i}}">已读</text></view></view><view wx:if="{{c}}" class="loading-tip">加载中...</view></scroll-view><view class="chat-input-bar"><input placeholder="输入消息..." class="msg-input" value="{{f}}" bindinput="{{g}}"/><button bindtap="{{h}}">发送</button></view></view></view>