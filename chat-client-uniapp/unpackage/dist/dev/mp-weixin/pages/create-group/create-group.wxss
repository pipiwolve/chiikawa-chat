/* ================ 视觉变量 ================ */
.data-v-c3f8f667:root {
  --theme-start: #6366f1;
  --theme-end: #8b5cf6;
  --bg: #f7f8fc;
  --card: #ffffff;
  --radius: 24rpx;
  --shadow: 0 8rpx 30rpx rgba(0, 0, 0, .06);
  --text-title: #1f2937;
  --text-desc: #6b7280;
  --ease: cubic-bezier(.4, .8, .2, 1);
}

/* ================ 页面骨架 ================ */
.page.data-v-c3f8f667 {
  background: var(--bg);
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ================ 卡片表单 ================ */
.form.data-v-c3f8f667 {
  width: 100%;
  max-width: 600rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 40rpx;
  box-sizing: border-box;
}
.form-item.data-v-c3f8f667 {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}
.label.data-v-c3f8f667 {
  font-size: 30rpx;
  color: var(--text-desc);
  margin-bottom: 12rpx;
}

/* 单行输入框 */
.input.data-v-c3f8f667 {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: var(--text-title);
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  transition: border-color 0.2s var(--ease);
}
.input.data-v-c3f8f667:focus {
  border-color: var(--theme-start);
}

/* 多行文本域 */
.textarea.data-v-c3f8f667 {
  height: 160rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: var(--text-title);
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  resize: none;
  /* 禁止拖动，防止样式穿帮 */
  transition: border-color 0.2s var(--ease);
}
.textarea.data-v-c3f8f667:focus {
  border-color: var(--theme-start);
}

/* ================ 渐变按钮 ================ */
.submit-btn.data-v-c3f8f667 {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 12rpx;
  background: linear-gradient(135deg, var(--theme-start), var(--theme-end));
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  transition: transform 0.15s var(--ease);
}
.submit-btn.data-v-c3f8f667:active {
  transform: scale(0.96);
}

/* ================ 状态提示 ================ */
.status.data-v-c3f8f667 {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: var(--text-desc);
}