/* ================ 视觉变量 ================ */
/* ================ 页面骨架 ================ */
.page.data-v-7c72e8e3 {
  background: #f7f8fc;
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

/* ================ 功能卡片 ================ */
.function-list.data-v-7c72e8e3 {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  margin-bottom: 30rpx;
}
.function-item.data-v-7c72e8e3 {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f2f2f2;
  transition: background-color 0.2s cubic-bezier(0.4, 0.8, 0.2, 1);
}
.function-item.data-v-7c72e8e3:last-child {
  border-bottom: none;
}
.function-item.data-v-7c72e8e3:active {
  background-color: #f8f8f8;
}
.icon.data-v-7c72e8e3 {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
}
.label.data-v-7c72e8e3 {
  font-size: 30rpx;
  color: #1f2937;
}

/* ================ 申请卡片 ================ */
.request-card.data-v-7c72e8e3 {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: transform 0.15s cubic-bezier(0.4, 0.8, 0.2, 1);
  /* 渐变同意按钮 */
}
.request-card.data-v-7c72e8e3:active {
  transform: scale(0.98);
}
.request-card .avatar.data-v-7c72e8e3 {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  /* 黑边防遮挡 */
  box-sizing: border-box;
}
.request-card .info.data-v-7c72e8e3 {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.request-card .info .username.data-v-7c72e8e3 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.request-card .info .message.data-v-7c72e8e3 {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 6rpx;
}
.request-card .accept-btn.data-v-7c72e8e3 {
  width: 112rpx;
  height: 64rpx;
  border: none;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #07c160, #05a14a);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  transition: transform 0.15s cubic-bezier(0.4, 0.8, 0.2, 1);
}
.request-card .accept-btn.data-v-7c72e8e3:active {
  transform: scale(0.92);
}

/* ================ 空状态 ================ */
.no-request.data-v-7c72e8e3 {
  margin-top: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
}