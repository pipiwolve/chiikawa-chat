/* ================ 视觉变量 ================ */
.data-v-db42cae2:root {
  --theme: #07c160;
  --bg: #f7f8fc;
  --card: #ffffff;
  --radius: 24rpx;
  --shadow: 0 8rpx 30rpx rgba(0, 0, 0, .06);
  --text-title: #1f2937;
  --text-desc: #6b7280;
  --ease: cubic-bezier(.4, .8, .2, 1);
}

/* ================ 背景图 ================ */
.bg-image.data-v-db42cae2 {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* ================ 页面骨架 ================ */
.page.data-v-db42cae2 {
  background: transparent;
  /* 关键：让背景图露出来 */
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

/* ================ 功能卡片 ================ */
.function-list.data-v-db42cae2 {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
  margin-bottom: 30rpx;
}
.function-item.data-v-db42cae2 {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f2f2f2;
  transition: background-color 0.2s var(--ease);
}
.function-item.data-v-db42cae2:last-child {
  border-bottom: none;
}
.function-item.data-v-db42cae2:active {
  background-color: #f8f8f8;
}
.icon.data-v-db42cae2 {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.label.data-v-db42cae2 {
  font-size: 30rpx;
  color: var(--text-title);
}

/* ================ 好友列表 ================ */
.list-item.data-v-db42cae2 {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  transition: transform 0.15s var(--ease);
}
.list-item.data-v-db42cae2:active {
  transform: scale(0.98);
}
.avatar.data-v-db42cae2 {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  /* 黑边防遮挡 */
  box-sizing: border-box;
}
.nickname.data-v-db42cae2 {
  font-size: 32rpx;
  color: var(--text-title);
  font-weight: 500;
}