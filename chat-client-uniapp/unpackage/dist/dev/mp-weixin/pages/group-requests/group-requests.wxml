<view class="page"><view class="function-list"><view class="function-item" bindtap="{{b}}"><image class="icon" src="{{a}}"></image><text class="label">我的群聊</text></view></view><view wx:for="{{c}}" wx:for-item="req" wx:key="e" class="request-card"><image class="avatar" src="{{req.a}}"></image><view class="info"><text class="username">{{req.b}}</text><text class="message">申请加入群聊 {{req.c}}</text></view><button class="accept-btn" bindtap="{{req.d}}">同意</button></view><view wx:if="{{d}}" class="no-request"> 暂无群聊申请 </view></view>