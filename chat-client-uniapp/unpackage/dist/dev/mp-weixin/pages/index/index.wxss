
/* 背景图铺满固定 */
.bg-image {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;        /* 垫在最下面 */
}


/* 2. 容器垂直水平居中 */
.index-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}

/* 3. 毛玻璃按钮 */
.index-container button {
  width: 200px;
  height: 44px;
  margin: 12px 0;
  border: none;
  border-radius: 22px;
  font-size: 16px;
  color: pink;                   /* 白色字 */
  background: rgba(0, 0, 0, 0.55);  /* 深灰半透明 */
  -webkit-backdrop-filter: blur(8px);
          backdrop-filter: blur(8px);
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
}
